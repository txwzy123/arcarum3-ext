    "98": { "statusId": 98, "text": { "zh-CN": "在火山区域的君临者格中，造成伤害提升(30%)/水属性追击效果(20%)/水属性奥义追击效果(20%)/敌人的预兆解除条件减少" }, "sources": ["community-zh-CN"] },
