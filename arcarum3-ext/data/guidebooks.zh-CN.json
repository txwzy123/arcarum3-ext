    "100": { "statusId": 100, "text": { "zh-CN": "在森林区域的君临者格中，造成伤害提升(30%)/风属性追击效果(20%)/风属性奥义追击效果(20%)/敌人的预兆解除条件减少" }, "sources": ["community-zh-CN"] },
